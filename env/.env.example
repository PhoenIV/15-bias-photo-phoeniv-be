#환경 설정
NODE_ENV=

# 서버 포트
PORT=

# PostgreSQL 연결 URL
DATABASE_URL="postgresql://<사용자명>:<비밀번호>@localhost:5432/prisma_auth"

# 서로 다른 32자 이상의 비밀키
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 쉼표로 구분한 운영 환경 허용 출처. 개발 환경에서는 비워 둘 수 있습니다.
# 예: CORS_ORIGINS=https://example.com,https://admin.example.com (주소 끝에 /를 붙이지 않음)
CORS_ORIGINS=
