#환경 설정
NODE_ENV=

# 서버 포트
PORT=

# NeonDB 주소
DATABASE_URL="postgresql://neondb_owner:비밀번호@ep-xxx.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"
SEED_DATABASE_HOST="ep-xxx.aws.neon.tech"

# 클라우디너리 설정 정보
CLOUDINARY_CLOUD_NAME="클라우드이름"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz"

# 서로 다른 32자 이상의 비밀키
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 쉼표로 구분한 운영 환경 허용 출처. 개발 환경에서는 비워 둘 수 있습니다.
# 예: CORS_ORIGINS=https://example.com,https://admin.example.com (주소 끝에 /를 붙이지 않음)
CORS_ORIGINS=
